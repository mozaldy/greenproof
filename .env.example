# ─── apps/api ────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:pass@localhost:5432/greenproof

# SUI Blockchain
SUI_NETWORK=testnet
SUI_SPONSOR_PRIVATE_KEY=            # deployer key — bayar gas untuk mitra
SUI_PACKAGE_ID=                     # deployed contract address setelah sui client publish

# LLM
ANTHROPIC_API_KEY=                  # Claude Haiku key

# Walrus
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
SEAL_SERVER_URL=https://seal.walrus-testnet.walrus.space

# Auth
JWT_SECRET=                         # random 64-char string

# Dev flags
LLM_MOCK=false                      # true = skip LLM, return dummy data
MOCK_WALRUS=false                   # true = simpan foto ke /tmp/greenproof-photos/, bukan ke Walrus

# ─── apps/dashboard ──────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── apps/mitra ──────────────────────────────────────────────────────────────

# NEXT_PUBLIC_API_URL=http://localhost:3001          # same as dashboard
NEXT_PUBLIC_GOOGLE_CLIENT_ID=                       # untuk zkLogin OAuth flow
