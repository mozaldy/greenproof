{
  "name": "greenproof",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @greenproof/db run db:generate",
    "db:migrate": "pnpm --filter @greenproof/db run db:migrate",
    "db:studio": "pnpm --filter @greenproof/db run db:studio"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^16.4.5",
    "turbo": "^2.3.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@mysten/sui.js": "0.54.1"
  }
}
