# SUI Network
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# GreenProof Contract (set after: npx tsx scripts/deploy.ts)
GREENPROOF_DEPLOYER_PRIVATE_KEY=   # hex-encoded Ed25519 private key (32 bytes)
GREENPROOF_PACKAGE_ID=             # SUI package ID from deploy output
GREENPROOF_ADMIN_CAP_ID=           # GreenproofAdminCap object ID from deploy output
GREENPROOF_SERVICE_ADDRESS=        # deployer SUI address (used as AI service identity)

# Walrus (decentralized storage)
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5
MOCK_WALRUS=true    # set to false to use real Walrus testnet

# Seal (access control for Walrus blobs)
SEAL_SERVICE_URL=   # leave empty to use mock
MOCK_SEAL=true

# Anthropic LLM
ANTHROPIC_API_KEY=
MOCK_LLM=true       # set to false to use real LLM (incurs API cost)

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/greenproof

# App
PORT=3001
NODE_ENV=development
